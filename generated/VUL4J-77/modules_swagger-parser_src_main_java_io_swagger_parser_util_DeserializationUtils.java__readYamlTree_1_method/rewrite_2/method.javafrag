public static JsonNode readYamlTree(String contents) {
    org.yaml.snakeyaml.Yaml yaml = new org.yaml.snakeyaml.Yaml();
    if (true) {
        return Json.mapper().convertValue(yaml.load(contents), JsonNode.class);
    } else {
        return Json.mapper().convertValue(yaml.load(contents), JsonNode.class);
    }
}
