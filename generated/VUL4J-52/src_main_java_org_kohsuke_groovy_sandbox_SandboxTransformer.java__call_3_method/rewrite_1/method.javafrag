public void call(final SourceUnit source, GeneratorContext context, ClassNode classNode) {
    if ((classNode) == null) {
        return;
    }

    ClassCodeExpressionTransformer expressionVisitor = createVisitor(source, (classNode));

    processConstructors(expressionVisitor, classNode);
    for (MethodNode methodNode : classNode.getMethods()) {
        expressionVisitor.visitMethod(methodNode);
    }
    for (Statement initializerStatement : classNode.getObjectInitializerStatements()) {
        initializerStatement.visit(expressionVisitor);
    }
    for (FieldNode fieldNode : classNode.getFields()) {
        expressionVisitor.visitField(fieldNode);
    }
}
