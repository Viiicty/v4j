public void read(final InputStream in, final LoaderOptions options)
        throws ConfigurationException
{
    try
    {
        final Yaml yaml = new Yaml(options);
        final Map<String, Object> map = (Map) yaml.load(in);
        load(map);
        return;
    }
    catch (final Exception e)
    {
        rethrowException(e);
    }
}
