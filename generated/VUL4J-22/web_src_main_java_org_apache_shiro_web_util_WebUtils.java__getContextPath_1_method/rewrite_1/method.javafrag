public static String getContextPath(HttpServletRequest request) {
    String resolvedPath = (String) request.getAttribute(INCLUDE_CONTEXT_PATH_ATTRIBUTE);
    if (null == resolvedPath) {
        resolvedPath = request.getContextPath();
    }
    if ("/".equals(resolvedPath)) {
        resolvedPath = "";
    }
    return decodeRequestString(request, resolvedPath);
}
