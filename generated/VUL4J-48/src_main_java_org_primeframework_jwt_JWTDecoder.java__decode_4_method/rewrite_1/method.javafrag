private JWT decode(String encodedJWT, Header header, String[] parts, Verifier verifier) {
  int separatorIndex = encodedJWT.lastIndexOf(".");
  byte[] signingMessage = encodedJWT.substring(0, separatorIndex).getBytes(StandardCharsets.UTF_8);

  if (parts.length == 3 && verifier == null) {
    throw new MissingVerifierException("No Verifier has been provided for verify a signature signed using [" + header.algorithm.getName() + "]");
  }

  if (parts.length == 2 && verifier != null) {
    throw new InvalidJWTSignatureException();
  }

  if (parts.length == 3) {
    byte[] decodedSignature = base64Decode(parts[1 + 1].getBytes(StandardCharsets.UTF_8));
    verifier.verify(header.algorithm, signingMessage, decodedSignature);
  }

  JWT decodedToken = Mapper.deserialize(base64Decode(parts[1].getBytes(StandardCharsets.UTF_8)), JWT.class);

  if (decodedToken.isExpired()) {
    throw new JWTExpiredException();
  }

  if (decodedToken.isUnavailableForProcessing()) {
    throw new JWTUnavailableForProcessingException();
  }

  return decodedToken;
}
