+public MultipartStream(InputStream sourceInput,
+        byte[] delimiter,
+        int bufferSize,
+        ProgressNotifier progressNotifier) {
+    this.input = sourceInput;
+    this.bufSize = bufferSize;
+    this.buffer = new byte[bufferSize];
+    this.notifier = progressNotifier;
+
+    this.boundary = new byte[(delimiter.length + BOUNDARY_PREFIX.length)];
+    this.boundaryLength = (delimiter.length + BOUNDARY_PREFIX.length);
+    this.keepRegion = this.boundary.length;
+    System.arraycopy(BOUNDARY_PREFIX, 0, this.boundary, 0,
+            BOUNDARY_PREFIX.length);
+    System.arraycopy(delimiter, 0, this.boundary, BOUNDARY_PREFIX.length,
+            delimiter.length);
+
+    head = 0x0;
+    tail = 0x0;
+}
 
